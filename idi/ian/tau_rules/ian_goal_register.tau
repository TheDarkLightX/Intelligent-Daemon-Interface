# Tau Language 0.8: Goal registration: i21=exists, i25=signature valid. o21 is 0/1 success/rejection.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i20:bv[4] := in console.
i21:sbf := in console.
i22:bv[256] := in console.
i23:bv[32] := in console.
i24:bv[2] := in console.
i25:sbf := in console.
o20:sbf := out console.
o21:bv[4] := out console.

always (
  ((o20[t] != 0) <-> (i20[t] = {2}:bv[4] && i21[t] = 0 && i22[t] != 0 && i23[t] != 0 && i24[t] <= {2}:bv[2] && i25[t] != 0)) &&
  ((o20[t] != 0) -> o21[t] = {0}:bv[4]) &&
  (!(o20[t] != 0) -> o21[t] = {1}:bv[4])
).
