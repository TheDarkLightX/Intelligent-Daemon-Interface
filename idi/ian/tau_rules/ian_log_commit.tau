# Tau Language 0.8: Commit: i31=registered, i39=last hash, i3A=signature, i3B=proof, i3C=min bond, i3D=host-computed new hash.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i30:bv[4] := in console.
i31:sbf := in console.
i32:bv[256] := in console.
i33:bv[64] := in console.
i34:bv[256] := in console.
i35:bv[64] := in console.
i36:bv[256] := in console.
i37:bv[64] := in console.
i38:bv[64] := in console.
i39:bv[256] := in console.
i3A:sbf := in console.
i3B:sbf := in console.
i3C:bv[64] := in console.
i3D:bv[256] := in console.
o30:sbf := out console.
o31:bv[256] := out console.

always (
  ((o30[t] != 0) <-> (i30[t] = {3}:bv[4] && i31[t] != 0 && i3A[t] != 0 && i3B[t] != 0 && i36[t] = i39[t] && i37[t] >= i3C[t] && i33[t] >= i38[t] && i35[t] <= i33[t] && i32[t] != 0 && i34[t] != 0 && i3D[t] != 0)) &&
  ((o30[t] != 0) -> o31[t] = i3D[t]) &&
  (!(o30[t] != 0) -> o31[t] = i39[t])
).
