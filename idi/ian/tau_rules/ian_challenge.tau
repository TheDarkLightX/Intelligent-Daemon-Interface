# Tau Language 0.8: Challenge: o50=admitted, o51=slash committer, o52=slash challenger; i51=exists, i52=resolved, i59=proof verified, A=period, B=min bond.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i50:bv[4] := in console.
i51:sbf := in console.
i52:sbf := in console.
i54:bv[64] := in console.
i55:bv[64] := in console.
i56:bv[64] := in console.
i57:bv[256] := in console.
i58:bv[256] := in console.
i59:sbf := in console.
i5A:bv[64] := in console.
i5B:bv[64] := in console.
o50:sbf := out console.
o51:sbf := out console.
o52:sbf := out console.

always (
  ((o50[t] != 0) <-> (i50[t] = {5}:bv[4] && i51[t] != 0 && i52[t] = 0 && i55[t] >= i54[t] && (i55[t] - i54[t]) < i5A[t] && i56[t] >= i5B[t])) &&
  ((o51[t] != 0) <-> (o50[t] != 0 && i59[t] != 0 && i57[t] != i58[t])) &&
  ((o52[t] != 0) <-> (o50[t] != 0 && o51[t] = 0))
).
