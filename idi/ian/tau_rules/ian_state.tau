# Tau Language 0.8: One-goal state fold of ALREADY VALIDATED register/commit/upgrade flags. Conflicting commit+upgrade holds both roots.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i0:sbf := in console.
i1:sbf := in console.
i2:sbf := in console.
i3:bv[256] := in console.
i4:bv[256] := in console.
o0:sbf := out console.
o1:bv[256] := out console.
o2:bv[256] := out console.
o3:bv[64] := out console.

always (
  (o0[0] = 0) &&
  (o1[0] = 0) &&
  (o2[0] = 0) &&
  (o3[0] = 0) &&
  (o0[t] = o0[t-1] | i0[t]) &&
  ((i1[t] != 0 && o0[t-1] != 0 && i2[t] = 0) -> o1[t] = i3[t]) &&
  (!(i1[t] != 0 && o0[t-1] != 0 && i2[t] = 0) -> o1[t] = o1[t-1]) &&
  ((i2[t] != 0 && o0[t-1] != 0 && i1[t] = 0 && o3[t-1] < {18446744073709551615}:bv[64]) -> o2[t] = i4[t]) &&
  (!(i2[t] != 0 && o0[t-1] != 0 && i1[t] = 0 && o3[t-1] < {18446744073709551615}:bv[64]) -> o2[t] = o2[t-1]) &&
  ((i2[t] != 0 && o0[t-1] != 0 && i1[t] = 0 && o3[t-1] < {18446744073709551615}:bv[64]) -> o3[t] = o3[t-1] + {1}:bv[64]) &&
  (!(i2[t] != 0 && o0[t-1] != 0 && i1[t] = 0 && o3[t-1] < {18446744073709551615}:bv[64]) -> o3[t] = o3[t-1])
).
