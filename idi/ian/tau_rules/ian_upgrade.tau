# Tau Language 0.8: Upgrade: no governance bypass of cooldown; unsigned fixed-point score; i4B=has policy, C=committed root, D=size, E=cooldown, F=signature, G=membership, H=count.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i40:bv[4] := in console.
i41:sbf := in console.
i42:bv[256] := in console.
i43:bv[64] := in console.
i44:bv[64] := in console.
i45:bv[256] := in console.
i46:bv[64] := in console.
i47:bv[64] := in console.
i48:bv[64] := in console.
i49:sbf := in console.
i4A:sbf := in console.
i4B:sbf := in console.
i4C:bv[256] := in console.
i4D:bv[64] := in console.
i4E:bv[64] := in console.
i4F:sbf := in console.
i4G:sbf := in console.
i4H:bv[64] := in console.
o40:sbf := out console.
o41:bv[64] := out console.

always (
  ((o40[t] != 0) <-> (i40[t] = {4}:bv[4] && i41[t] != 0 && i42[t] != 0 && (i4B[t] = 0 || i43[t] > i46[t]) && i44[t] < i4D[t] && i45[t] = i4C[t] && i48[t] >= i47[t] && (i48[t] - i47[t]) >= i4E[t] && (i49[t] = 0 || i4A[t] != 0) && i4F[t] != 0 && i4G[t] != 0 && i4H[t] < {18446744073709551615}:bv[64])) &&
  ((o40[t] != 0) -> o41[t] = i4H[t] + {1}:bv[64]) &&
  (!(o40[t] != 0) -> o41[t] = i4H[t])
).
