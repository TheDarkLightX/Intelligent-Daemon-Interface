# Tau Language 0.8: Authorized half-slash (6) or checked deposit (7). i63=bond, i64=deposit, i65=max. Withdrawals/escalation remain outside this contract.
# Run with --charvar off. Native BV build required (browser build omits BV).
# Inputs are facts for one goal. Host verifies signatures, proofs and state identity.
# These constraints do not implement hashing, a ledger, network consensus or finality.

i60:bv[4] := in console.
i61:sbf := in console.
i63:bv[64] := in console.
i64:bv[64] := in console.
i65:bv[64] := in console.
o60:sbf := out console.
o61:bv[64] := out console.
o62:bv[64] := out console.
o63:bv[64] := out console.
o64:bv[64] := out console.
o65:bv[64] := out console.

always (
  ((o60[t] != 0) <-> ((i60[t] = {6}:bv[4] && i61[t] != 0 && i63[t] != 0) || (i60[t] = {7}:bv[4] && i61[t] != 0 && i64[t] != 0 && i63[t] <= i65[t] && i64[t] <= (i65[t] - i63[t])))) &&
  ((i60[t] = {6}:bv[4] && i61[t] != 0 && i63[t] != 0) -> o61[t] = i63[t] >> {1}:bv[64]) &&
  (!(i60[t] = {6}:bv[4] && i61[t] != 0 && i63[t] != 0) -> o61[t] = {0}:bv[64]) &&
  (o62[t] = o61[t] >> {2}:bv[64]) &&
  (o63[t] = o61[t] >> {2}:bv[64]) &&
  (o64[t] = o61[t] - o62[t] - o63[t]) &&
  ((i60[t] = {7}:bv[4] && i61[t] != 0 && i64[t] != 0 && i63[t] <= i65[t] && i64[t] <= (i65[t] - i63[t])) -> o65[t] = i63[t] + i64[t]) &&
  (!(i60[t] = {7}:bv[4] && i61[t] != 0 && i64[t] != 0 && i63[t] <= i65[t] && i64[t] <= (i65[t] - i63[t])) -> o65[t] = i63[t] - o61[t])
).
