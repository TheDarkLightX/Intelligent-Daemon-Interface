# Tau 0.8: deterministic 16-bit Galois LFSR, polynomial mask 0xB400.
# At t=0 both outputs are zero. At t=1, seed=0 maps to 1; otherwise
# the current seed becomes the state. Subsequent steps advance the LFSR.
# o_rand XORs the current state with the current host seed. Only the internal
# nonzero state has the checked 65535-step cycle. Changing seed changes o_rand.
# This is predictable and provides no cryptographic entropy or front-running protection.
i_seed:bv[16] := in console.
o_rand:bv[16] := out console.
o_lfsr:bv[16] := out console.
always (
  (o_lfsr[0] = {0}:bv[16]) && (o_rand[0] = {0}:bv[16]) &&
  ((o_lfsr[t-1] = {0}:bv[16] && i_seed[t] = {0}:bv[16]) -> o_lfsr[t] = {1}:bv[16]) &&
  ((o_lfsr[t-1] = {0}:bv[16] && i_seed[t] != {0}:bv[16]) -> o_lfsr[t] = i_seed[t]) &&
  ((o_lfsr[t-1] != {0}:bv[16] && (o_lfsr[t-1] & {1}:bv[16]) != {0}:bv[16]) -> o_lfsr[t] = ((o_lfsr[t-1] >> {1}:bv[16]) ^ {#xB400}:bv[16])) &&
  ((o_lfsr[t-1] != {0}:bv[16] && (o_lfsr[t-1] & {1}:bv[16]) = {0}:bv[16]) -> o_lfsr[t] = (o_lfsr[t-1] >> {1}:bv[16])) &&
  (o_rand[t] = o_lfsr[t] ^ i_seed[t])
).
