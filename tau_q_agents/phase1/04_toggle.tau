# Toggle - XOR with previous state
# o[t] = (i[t] AND NOT o[t-1]) OR (NOT i[t] AND o[t-1])
# Input 1 toggles state, input 0 keeps state
# Deterministic initial condition: o1[0] = 0

i1:sbf := in console. 
o1:sbf := out console. 
always (
(o1[t] = (i1[t] & o1[t-1]') | (i1[t]' & o1[t-1])) && (o1[0] = 0)
).
