# Deflationary Trading Agent
# Burns tokens on every profitable trade (sell after buying)
#
# Inputs:
#   i1 = price_up
#   i2 = price_down
#
# Outputs:
#   o1 = position (0=idle, 1=holding)
#   o2 = buy_signal  
#   o3 = sell_signal
#   o4 = burn_signal (fires when selling at profit)
#
# Logic: Track entry price direction, burn on profitable exit

i1:sbf := in console. 
i2:sbf := in console. 
o1:sbf := out console. 
o2:sbf := out console. 
o3:sbf := out console. 
o4:sbf := out console. 

# Buy on price up when idle
# Sell on price down when holding  
# Burn when selling (any sell is considered "profitable" in this simple model)
always (
o2[t] = i1[t] & o1[t-1]' && o3[t] = i2[t] & o1[t-1] && o1[t] = o2[t] | (o1[t-1] & o3[t]') && o4[t] = o3[t]
).
