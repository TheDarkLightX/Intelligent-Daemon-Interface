# Tau 0.8 profit comparison: captures entry price and holds it.
# This compares unsigned 8-bit prices; it does not account for fees or trade execution.
price:bv[8] := in console.
buy_signal:sbf := in console.
sell_signal:sbf := in console.
holding:sbf := in console.
buy_price:bv[8] := out console.
is_profitable:sbf := out console.
always (
  (buy_price[0] = {0}:bv[8]) &&
  (((buy_signal[t] != 0) && (holding[t-1] = 0)) -> buy_price[t] = price[t]) &&
  ((!((buy_signal[t] != 0) && (holding[t-1] = 0))) -> buy_price[t] = buy_price[t-1]) &&
  ((is_profitable[t] != 0) <-> (price[t] > buy_price[t]))
).
